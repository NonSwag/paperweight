{
  "name": "paper-server",
  "main": "org.bukkit.craftbukkit.Main",
  "sources": ["src/main/java", "src/generated/java", "src/minecraft/java"],
  "resources": ["src/main/resources", "src/minecraft/resources"],
  "runtime": {
    "workspace:paper-api": "*",
    // Minecraft's libraries, from mache's metadata
    "ext:paperweight/mache": "26.3+build.2",
    "ca.spottedleaf.leafpile:common": "1.3.2",
    "ca.spottedleaf.leafpile:concurrentutil": "1.3.2",
    "ca.spottedleaf.leafpile:converter": "1.3.2",
    "ca.spottedleaf.leafpile:ioutil": "1.3.2",
    "org.jline:jline-terminal-ffm": "4.4.6",
    "net.minecrell:terminalconsoleappender": "1.3.0",
    "net.kyori:adventure-text-serializer-ansi": "5.2.0",
    "org.apache.logging.log4j:log4j-core": "2.26.0",
    "com.velocitypowered:velocity-native": { "version": "4.1.0", "exclude": ["*"] },
    "io.netty:netty-codec-haproxy": "4.2.16.Final",
    "org.apache.logging.log4j:log4j-iostreams": "2.26.0",
    "org.ow2.asm:asm-commons": "9.9.1",
    "org.spongepowered:configurate-yaml": "4.2.0",
    "commons-lang:commons-lang": { "version": "2.6", "runtimeOnly": true },
    "org.xerial:sqlite-jdbc": { "version": "3.49.1.0", "runtimeOnly": true },
    "com.mysql:mysql-connector-j": { "version": "9.2.0", "runtimeOnly": true },
    "com.lmax:disruptor": { "version": "3.4.4", "runtimeOnly": true },
    "com.googlecode.json-simple:json-simple": { "version": "1.1.1", "exclude": ["*"] },
    "me.lucko:spark-api": "0.1-20240720.200737-2",
    "me.lucko:spark-paper": "1.10.191"
  },
  "dev": {
    "org.jetbrains:annotations": "26.1.0",
    "com.google.code.findbugs:jsr305": "3.0.2"
  },
  "extensions": {
    "paperweight": { "minecraftVersion": "26.3", "mache": "io.papermc:mache:26.3+build.2" }
  }
}
