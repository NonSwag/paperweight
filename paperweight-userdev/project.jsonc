// The io.papermc.paperweight.userdev plugin. `jpm build --bundle` writes the plugin jar,
// dist/paperweight-userdev-<version>-bundle.jar, with paperweight-lib and the dependencies relocated under paper.libs.
{
  "name": "paperweight-userdev",
  "description": "Gradle plugin for developing Paper plugins using server internals",
  "package": "bundle",
  "runtime": {
    "workspace:paperweight-lib": "*",
    "com.github.salomonbrys.kotson:kotson": "2.5.0",
    "com.google.code.gson:gson": "2.14.0",
    "io.codechicken:DiffPatch:all": { "version": "1.5.0.30", "exclude": ["*"] },
    "org.jetbrains.kotlinx:kotlinx-coroutines-core": "1.11.0",
    "org.ow2.asm:asm": "9.10.1",
    "org.ow2.asm:asm-tree": "9.10.1"
  },
  "dev": {
    "gradle:api": "9.8.0"
  },
  "test": {
    "gradle:api": "9.8.0",
    "org.jetbrains.kotlin:kotlin-test-junit5": "2.4.10",
    "org.junit.jupiter:junit-jupiter-engine": "6.1.3",
    "org.junit.jupiter:junit-jupiter-params": "6.1.3",
    "org.junit.platform:junit-platform-launcher": "6.1.3"
  },
  // shaded like the Gradle build did, so the plugins cannot clash with other plugins' versions of these
  "relocate": {
    "codechicken.diffpatch": "paper.libs.codechicken.diffpatch",
    "codechicken.repack": "paper.libs.codechicken.repack",
    "com.github.salomonbrys.kotson": "paper.libs.com.github.salomonbrys.kotson",
    "com.google.gson": "paper.libs.com.google.gson",
    "dev.denwav.hypo": "paper.libs.dev.denwav.hypo",
    "org.jgrapht": "paper.libs.org.jgrapht",
    "org.jheaps": "paper.libs.org.jheaps",
    "com.google.errorprone.annotations": "paper.libs.com.google.errorprone.annotations",
    "org.objectweb.asm": "paper.libs.org.objectweb.asm",
    "io.sigpipe.jbsdiff": "paper.libs.io.sigpipe.jbsdiff",
    "org.tukaani.xz": "paper.libs.org.tukaani.xz",
    "org.apache.commons": "paper.libs.org.apache.commons",
    "net.fabricmc": "paper.libs.net.fabricmc",
    "org.apache.hc": "paper.libs.org.apache.hc",
    "org.cadixdev": "paper.libs.org.cadixdev",
    "me.jamiemansfield": "paper.libs.me.jamiemansfield",
    "org.eclipse.jgit": "paper.libs.org.eclipse.jgit",
    "com.googlecode.javaewah": "paper.libs.com.googlecode.javaewah",
    "com.googlecode.javaewah32": "paper.libs.com.googlecode.javaewah32",
    "kotlinx.coroutines": "paper.libs.kotlinx.coroutines",
    "org.intellij.lang": "paper.libs.org.intellij.lang",
    "org.jetbrains.annotations": "paper.libs.org.jetbrains.annotations"
  },
  "extensions": { "publish": { "skip": true } }
}
