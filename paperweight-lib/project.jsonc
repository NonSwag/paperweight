// The shared implementation of the plugins. It is not published on its own: paperweight-core and
// paperweight-userdev include it in their jars.
{
  "name": "paperweight-lib",
  // versions the plugins need at run time, as constants in LibraryVersions
  "defineClass": "io.papermc.paperweight.util.LibraryVersionDefines",
  "define": {
    "JST": "1.0.68+paper.2-SNAPSHOT",
    "TINY_REMAPPER": "0.14.1",
    "CHECKSTYLE": "12.1.2"
  },
  "runtime": {
    "org.apache.httpcomponents.client5:httpclient5": "5.6.4",
    "com.github.salomonbrys.kotson:kotson": "2.5.0",
    "com.google.code.gson:gson": "2.14.0",
    "org.jetbrains.kotlinx:kotlinx-coroutines-core": "1.11.0",
    "org.ow2.asm:asm": "9.10.1",
    "org.ow2.asm:asm-tree": "9.10.1",
    "dev.denwav.hypo:hypo-model": "1.2.4",
    "dev.denwav.hypo:hypo-core": "1.2.4",
    "dev.denwav.hypo:hypo-hydrate": "1.2.4",
    "dev.denwav.hypo:hypo-asm": "1.2.4",
    "dev.denwav.hypo:hypo-asm-hydrate": "1.2.4",
    "dev.denwav.hypo:hypo-mappings": "1.2.4",
    "org.cadixdev:lorenz": "0.5.8",
    "org.cadixdev:lorenz-asm": "0.5.8",
    "org.cadixdev:lorenz-io-proguard": "0.5.8",
    "org.cadixdev:atlas": "0.2.1",
    "org.cadixdev:at": "0.1.0-rc1",
    "net.fabricmc:lorenz-tiny": "3.0.0",
    "io.sigpipe:jbsdiff": "1.0",
    "io.codechicken:DiffPatch:all": { "version": "1.5.0.30", "exclude": ["*"] }
  },
  "dev": {
    "gradle:api": "9.8.0"
  },
  "test": {
    "gradle:api": "9.8.0",
    "org.jetbrains.kotlin:kotlin-test-junit5": "2.4.10",
    "org.junit.jupiter:junit-jupiter-engine": "6.1.3",
    "org.junit.jupiter:junit-jupiter-params": "6.1.3",
    "org.junit.platform:junit-platform-launcher": "6.1.3",
    "org.eclipse.jgit:org.eclipse.jgit": "7.8.0.202609011348-r",
    "io.mockk:mockk": "1.14.11"
  },
  "extensions": { "publish": { "skip": true } }
}
